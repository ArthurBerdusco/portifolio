# --- Backoffice (/admin) ---
# Senha de acesso ao backoffice (obrigatória)
ADMIN_PASSWORD=GMX3-Rel.10
# Segredo para assinar o cookie de sessão (opcional; gere algo longo e aleatório)
ADMIN_SECRET=GMX3-Rel.10

# --- Armazenamento do conteúdo (Upstash Redis / Vercel Marketplace) ---
# Em produção (Vercel) é necessário. Em desenvolvimento, sem isso, o conteúdo é salvo em .data/content.json
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (As variáveis KV_REST_API_URL / KV_REST_API_TOKEN também são aceitas)

# --- Upload de imagens (opcional, Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=

# URL pública do site (usada em sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=https://arthurberdusco.vercel.app
